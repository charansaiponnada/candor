    DG["Device gate<br/>battery ≥ 20%<br/>thermal &lt; MODERATE"] --> R
    R -->|"confident"| A1["Answer<br/>badge: Tier-1"]
    R -->|"low + headroom"| T2["Tier-2 · Qwen2.5 1.5B<br/>escalated answer"]
    R -->|"low, no headroom"| CN["Tier-1 kept<br/>badge: constrained + reason"]
    T2 --> A2["Answer<br/>badge: Tier-2"]
    SK --> OUT["Every answer carries<br/>tier · latency · confidence<br/>escalations logged to JSONL"]
    PA --> OUT
    A1 --> OUT
    A2 --> OUT
    CN --> OUT
